APP_NAME=PRAJA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=praja
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# =========================================================================
# KONFIGURASI EMAIL OTP
# =========================================================================
# Pilih salah satu MAIL_MAILER di bawah ini:
#   - "smtp"            -> untuk Gmail biasa (atau SMTP lain) dengan App Password
#   - "microsoft-graph" -> untuk mengirim email dari akun Microsoft 365 / Outlook
#                          menggunakan Microsoft Graph API (Azure AD App + OAuth2)
#
# Selama development, boleh dibiarkan "log" agar OTP tetap tercatat di
# storage/logs/laravel.log tanpa perlu kredensial email.
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Opsi 1: Gmail biasa via SMTP -----------------------------------------
# 1. Aktifkan 2-Step Verification di akun Google Anda.
# 2. Buat "App Password" di https://myaccount.google.com/apppasswords
# 3. Isi MAIL_USERNAME dengan alamat Gmail dan MAIL_PASSWORD dengan App
#    Password (BUKAN password akun Google biasa).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_ENCRYPTION=tls

# --- Opsi 2: Microsoft 365 / Outlook via Microsoft Graph (SSO/OAuth2) -----
# Basic-auth SMTP Microsoft sudah dinonaktifkan, jadi pengiriman dilakukan
# lewat Microsoft Graph API dengan Azure AD App Registration (client
# credentials flow), bukan login SMTP biasa.
# 1. Daftarkan aplikasi di https://portal.azure.com -> Azure Active
#    Directory -> App registrations -> New registration.
# 2. Tambahkan permission "Mail.Send" (Application permission) pada
#    Microsoft Graph, lalu klik "Grant admin consent".
# 3. Buat Client Secret di menu "Certificates & secrets".
# 4. Isi tiga variabel di bawah ini dengan nilai dari Azure App tersebut,
#    lalu set MAIL_MAILER=microsoft-graph di atas.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
# Alamat pengirim harus mailbox asli di tenant Microsoft 365 tersebut.
# Kosongkan agar memakai MAIL_FROM_ADDRESS / MAIL_FROM_NAME di atas.
MICROSOFT_GRAPH_FROM_ADDRESS=
MICROSOFT_GRAPH_FROM_NAME=
MAIL_SAVE_TO_SENT_ITEMS=false

VITE_APP_NAME="${APP_NAME}"
